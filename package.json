{
  "name": "@ora-space/claude-agent",
  "version": "0.2.0",
  "description": "Ora agent plugin that runs Claude Code as an ACP agent.",
  "type": "module",
  "license": "Apache-2.0",
  "ora": {
    "manifestVersion": 1,
    "id": "ora-space.claude",
    "displayName": "Claude Code",
    "kind": "agent",
    "main": "./src/main.ts",
    "engines": {
      "ora": ">= 0.9.0",
      "pluginApi": 1
    },
    "contributes": {
      "agents": [
        {
          "id": "claude",
          "displayName": "Claude Code",
          "contractVersion": 1
        }
      ]
    },
    "permissions": {
      "run": true,
      "read": true,
      "env": ["ORA_CLAUDE_ACP_BIN", "PATH", "HOME", "USERPROFILE", "PATHEXT"],
      "net": true
    }
  }
}

{
  "name": "@ora-space/claude-agent",
  "version": "0.2.0",
  "exports": "./src/main.ts",
  "imports": {
    "@ora-space/plugin-sdk": "jsr:@ora-space/plugin-sdk@^1.0.0",
    "@ora-space/plugin-sdk/": "jsr:@ora-space/plugin-sdk@^1.0.0/"
  },
  "lock": true,
  "tasks": {
    "check": "deno check src/main.ts tests/*.ts",
    "lint": "deno lint src tests",
    "format": "deno fmt src tests deno.json package.json README.md",
    "simulate": "deno test --allow-run --allow-read --allow-env --allow-net tests/",
    "dev": "deno run --no-prompt --allow-run --allow-read --allow-env --allow-net src/main.ts"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.ns", "dom", "esnext"]
  },
  "fmt": {
    "lineWidth": 80,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
